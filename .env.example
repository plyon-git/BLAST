# Copy to .env; source it in your shell. Never commit populated environment files.
BLASTIO_DB=data/blastio.sqlite3
BLASTIO_MODE=simulation
BLASTIO_ALLOW_PRODUCTION=false
BLASTIO_PUBLIC_URL=http://127.0.0.1:8000
BLASTIO_COOKIE_SECURE=false
BLASTIO_BUSINESS_NAME=101XVC
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BLASTIO_ENCRYPTION_KEY=
# Planning assumption only. Set to your conservative all-in per-segment estimate.
BLASTIO_SEGMENT_COST=0.015
